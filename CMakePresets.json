{
    "version": 8,
    "configurePresets": [
        {
            "name": "debug",
            "displayName": "debug",
            "description": "Using compilers: C = /usr/bin/clang-20, CXX = /usr/bin/clang++-20",
            "binaryDir": "${sourceDir}/out/build/${presetName}",
            "cacheVariables": {
                "CMAKE_INSTALL_PREFIX": "${sourceDir}/out/install/${presetName}",
                "CMAKE_C_COMPILER": "/usr/bin/clang-20",
                "CMAKE_CXX_COMPILER": "/usr/bin/clang++-20",
                "CMAKE_BUILD_TYPE": "Debug",
                "CMAKE_EXPORT_COMPILE_COMMANDS": "YES",
                "CMAKE_PREFIX_PATH" : "${sourceDir}/.pixi/envs/default;${sourceDir}/out/build/debug"
            }
        }
        ,
        {
            "name": "release",
            "displayName": "release",
            "description": "Release build using Clang with optimizations",
            "binaryDir": "${sourceDir}/out/build/${presetName}",
            "cacheVariables": {
                "CMAKE_INSTALL_PREFIX": "${sourceDir}/out/install/${presetName}",
                "CMAKE_C_COMPILER": "/usr/bin/clang-20",
                "CMAKE_CXX_COMPILER": "/usr/bin/clang++-20",
                "CMAKE_BUILD_TYPE": "Release",
                "CMAKE_EXPORT_COMPILE_COMMANDS": "YES",
                "COMPILER_OPTIMISATION_SETTINGS": "ON",
                "CMAKE_PREFIX_PATH" : "${sourceDir}/out/build/release"
            }
        }
    ]
}